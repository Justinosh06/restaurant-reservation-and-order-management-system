<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Restaurant_Reservation_and_Order_Management_System</RootNamespace>
    <UserSecretsId>4bb94619-8734-49dc-bb4c-e5473c29da0d</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <PackageReference Include="Stripe.net" Version="53.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Images uploaded through the site (menu photos, ...) are data, not code: dotnet watch must not
       react to them, or it restarts the app (and can crash) every time someone uploads a file. -->
  <ItemGroup>
    <Content Update="wwwroot\uploads\**" Watch="false" />
    <Watch Remove="wwwroot\uploads\**" />
  </ItemGroup>

  <!-- The policy texts (shown by Pages/Policies) are read from disk, so they ship with the site. -->
  <ItemGroup>
    <None Update="Content\Policies\*.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
