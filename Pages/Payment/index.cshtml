@page "/Payment/{paymentId}"
@model RestaurantReservation.Pages.Payment.IndexModel
@{
    ViewData["Title"] = $"{Model.PaymentId} Payment Details";
}

<html>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>@ViewData["Title"]</title>
        <script type="importmap"></script>
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/payment_page.css" asp-append-version="true" />
    </head>
    <body>
        <div class="page-content">
            <div class="status-container">
                <i class="@Model.StatusIcon @Model.StatusIconClass" aria-hidden="true"></i>
                <span class="payment-status">@Model.StatusLabel</span>
                <span class="payment-status-msg">@Model.StatusMessage</span>
            </div>

            <div class="payment-container">
                <div class="inner-container">
                    <h3 class="amount-header">Amount</h3>
                    <span class="amount">@Model.CurrencySymbol @Model.AmountWhole<span>.@Model.AmountFraction</span></span>

                    <div class="data-row">
                        <span><i class="fa-solid fa-receipt"></i> Payment ID</span>
                        <span>@Model.PaymentId</span>
                    </div>
                    <div class="data-row">
                        <span><i class="fa-solid fa-cash-register"></i> Payment Method</span>
                        <span>@Model.PaymentMethodLabel</span>
                    </div>
                    <div class="data-row">
                        <span><i class="fa-regular fa-user"></i> Customer</span>
                        <span>@Model.CustomerName</span>
                    </div>
                    <div class="data-row">
                        <span><i class="fa-regular fa-calendar"></i> Date</span>
                        <span>@Model.CreatedAtDisplay</span>
                    </div>
                </div>
            </div>
            <div class="btn-container">
                @if (!Model.ShowRetryButton && !Model.ShowRefreshButton)
                {
                    <a class="back-btn" href="@Model.BackUrl">@Model.BackLabel</a>
                }
                @if (Model.ShowReceiptButton)
                {
                    <a class="receipt-btn" href="@Model.ReceiptUrl" target="_blank" rel="noopener noreferrer">View Receipt</a>
                }
                @if (Model.ShowRetryButton)
                {
                    @if (Model.RetryUrl is not null)
                    {
                        <a class="retry-btn" href="@Model.RetryUrl">Retry</a>
                    }
                    else
                    {
                        <button type="button" class="retry-btn">Retry</button>
                    }
                }
                @if (Model.ShowRefreshButton)
                {
                    <button type="button" class="refresh-btn" onclick="window.location.reload()">Refresh Status</button>
                }
            </div>
        </div>
    </body>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://kit.fontawesome.com/f3ce044c74.js" crossorigin="anonymous"></script>
</html>