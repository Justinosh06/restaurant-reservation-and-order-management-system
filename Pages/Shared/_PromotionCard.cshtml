@model RestaurantReservation.Models.Promotion
@{
    // One promotion poster (styles in promotion_popup.css). Shown by the pop-up on the landing and table pages
    // (_PromotionPopup) and when a promotion is opened on the customer's Promotions page.
    // The promotion runs to the end of its last day; the countdown counts down to that moment.
    var endsAt = Model.EndDate.ToDateTime(new TimeOnly(23, 59, 59));

    // e.g. "20% off" or "RM 10.00 off, min. spend RM 100.00".
    string DiscountText(RestaurantReservation.Models.Promotion promotion)
    {
        var off = promotion.DiscountType == RestaurantReservation.Models.PromotionDiscountType.Percentage
            ? $"{promotion.DiscountValue}% off"
            : $"RM {promotion.DiscountValue / 100m:F2} off";
        return promotion.MinimumSpend > 0 ? $"{off}, min. spend RM {promotion.MinimumSpend / 100m:F2}" : off;
    }
}

<section class="promo-card" data-promo-id="@Model.Id" role="dialog" aria-modal="true"
         aria-labelledby="promo-title-@Model.Id" hidden>
    <button type="button" class="promo-close" aria-label="Close promotion">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
    </button>

    <span class="promo-tag"><i class="fa-solid fa-bolt" aria-hidden="true"></i> Limited-time promotion</span>

    <h2 class="promo-title" id="promo-title-@Model.Id">@Model.Title</h2>

    <p class="promo-countdown">
        <i class="fa-regular fa-clock" aria-hidden="true"></i>
        Ends in: <span class="promo-time-left" data-ends="@endsAt.ToString("yyyy-MM-ddTHH:mm:ss")"></span>
    </p>

    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
    {
        <img class="promo-image" src="@Url.Content(Model.ImageUrl)" alt="@Model.Title" />
    }

    <p class="promo-description">@Model.Description</p>

    @* A code only means something at checkout once the promotion has a discount. *@
    @if (!string.IsNullOrWhiteSpace(Model.Code) && Model.DiscountType is not null)
    {
        <p class="promo-code">Use code <strong>@Model.Code</strong> at checkout for @DiscountText(Model)</p>
    }

    <p class="promo-dates">
        Valid @Model.StartDate.ToString("d MMM") &ndash; @Model.EndDate.ToString("d MMM yyyy")
        <span class="promo-count"></span>
    </p>
</section>
