@using Microsoft.EntityFrameworkCore
@using RestaurantReservation.Data
@using RestaurantReservation.Models
@inject ApplicationDbContext Db
@{
    // Promotion posters that pop up one after another, on the landing page and the table ordering page.
    // Only promotions running today are shown. promotionPopup.js skips any the visitor already closed
    // in this browser tab (sessionStorage), so logging in or reloading does not show them again.
    // The poster is for reading only: the close button is the one thing to click.
    var today = DateOnly.FromDateTime(DateTime.Now);
    var promotions = await Db.Promotions
        .AsNoTracking()
        .Where(p => p.StartDate <= today && p.EndDate >= today)
        .OrderBy(p => p.EndDate)
        .ThenBy(p => p.Title)
        .ToListAsync();

    // e.g. "20% off" or "RM 10.00 off, min. spend RM 100.00".
    string DiscountText(Promotion promotion)
    {
        var off = promotion.DiscountType == PromotionDiscountType.Percentage
            ? $"{promotion.DiscountValue}% off"
            : $"RM {promotion.DiscountValue / 100m:F2} off";
        return promotion.MinimumSpend > 0 ? $"{off}, min. spend RM {promotion.MinimumSpend / 100m:F2}" : off;
    }
}

@if (promotions.Count > 0)
{
    <link rel="stylesheet" href="~/css/promotion_popup.css" asp-append-version="true" />

    <div class="promo-popup" id="promo-popup" hidden>
        @foreach (var promotion in promotions)
        {
            // The promotion runs to the end of its last day; the countdown counts down to that moment.
            var endsAt = promotion.EndDate.ToDateTime(new TimeOnly(23, 59, 59));

            <section class="promo-card" data-promo-id="@promotion.Id" role="dialog" aria-modal="true"
                     aria-labelledby="promo-title-@promotion.Id" hidden>
                <button type="button" class="promo-close" aria-label="Close promotion">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>

                <span class="promo-tag"><i class="fa-solid fa-bolt" aria-hidden="true"></i> Limited-time promotion</span>

                <h2 class="promo-title" id="promo-title-@promotion.Id">@promotion.Title</h2>

                <p class="promo-countdown">
                    <i class="fa-regular fa-clock" aria-hidden="true"></i>
                    Ends in: <span class="promo-time-left" data-ends="@endsAt.ToString("yyyy-MM-ddTHH:mm:ss")"></span>
                </p>

                @if (!string.IsNullOrWhiteSpace(promotion.ImageUrl))
                {
                    <img class="promo-image" src="@Url.Content(promotion.ImageUrl)" alt="@promotion.Title" />
                }

                <p class="promo-description">@promotion.Description</p>

                @* A code only means something at checkout once the promotion has a discount. *@
                @if (!string.IsNullOrWhiteSpace(promotion.Code) && promotion.DiscountType is not null)
                {
                    <p class="promo-code">Use code <strong>@promotion.Code</strong> at checkout for @DiscountText(promotion)</p>
                }

                <p class="promo-dates">
                    Valid @promotion.StartDate.ToString("d MMM") &ndash; @promotion.EndDate.ToString("d MMM yyyy")
                    <span class="promo-count"></span>
                </p>
            </section>
        }
    </div>

    <script src="~/js/promotionPopup.js" asp-append-version="true"></script>
}
