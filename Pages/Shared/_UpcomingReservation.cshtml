@using RestaurantReservation.Models
@model RestaurantReservation.Models.Reservation

@* One upcoming booking: date, time and status on top, the booking details below.
   Used by the Upcoming reservations page. *@

<div class="upcoming-head">
    <div class="upcoming-date">
        <strong>@Model.Date.ToString("dd")</strong>
        <span>@Model.Date.ToString("MMM")</span>
    </div>
    <div>
        <span class="upcoming-day">@Model.Date.ToString("dddd")</span>
        <span class="upcoming-time">@Model.TimeSlot.ToString("h:mm tt")</span>
    </div>
    <span class="status-pill @(Model.Status == ReservationStatus.Pending ? "muted" : "")">@Model.Status</span>
</div>

<dl class="upcoming-details">
    <div>
        <dt>Name</dt>
        <dd>@(Model.Customer?.FullName ?? User.Identity?.Name)</dd>
    </div>
    <div>
        <dt>Guests</dt>
        <dd>@Model.Pax @(Model.Pax == 1 ? "guest" : "guests")</dd>
    </div>
    <div>
        <dt>Table</dt>
        <dd>@(string.IsNullOrEmpty(Model.TableId) ? "Not assigned yet" : $"Table {Model.TableId}")</dd>
    </div>
    <div>
        <dt>Contact</dt>
        <dd>@(string.IsNullOrWhiteSpace(Model.Customer?.PhoneNumber) ? "-" : Model.Customer!.PhoneNumber)</dd>
    </div>
    <div class="wide">
        <dt>Booking ID</dt>
        <dd>@Model.Id</dd>
    </div>
</dl>
