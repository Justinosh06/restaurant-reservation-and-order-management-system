@page
@using RestaurantReservation.Extensions
@using RestaurantReservation.Models.Enums
@model Restaurant_Reservation_and_Order_Management_System.Pages.Menu.IndexModel
@{
    ViewData["Title"] = "Menu";
}

<link rel="stylesheet" href="~/css/menu_index.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/menu_search.css" asp-append-version="true" />

@* Search and category filters work like the table menu (Pages/Table/Index), driven by tableMenu.js.
   The only food count is the one beside the heading; it follows the search and the chosen category. *@
<div class="menu-container">
    <section class="menu-intro">
        <div>
            <p class="menu-eyebrow">Fresh from our kitchen</p>
            <h1 class="menu-title">Explore the menu</h1>
            <p class="menu-description">Find something delicious to make your day.</p>
        </div>
        <p class="menu-result-count">
            <span id="menu-total-count">@Model.Items.Count</span>
            <span>items</span>
        </p>
    </section>

    <nav class="pill-filter-row" aria-label="Search and filter the menu">
        <div class="menu-search">
            <button type="button" class="searchbar-btn" aria-label="Search menu" aria-expanded="false">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            </button>

            <div class="search-modal" role="dialog" aria-modal="true" aria-label="Search menu" hidden>
                <form class="searchbar-popup">
                    <input id="menu-search-input" class="searchbar-input" type="search" placeholder="Search menu items" autocomplete="off" />
                    <button type="submit" class="searchbar-submit">Search</button>
                    <button type="button" class="searchbar-close" aria-label="Close search">&times;</button>
                </form>
                <div class="search-recommendations" hidden>
                    <div class="search-recommendation-group search-recent-searches" hidden>
                        <h2>Recent searches</h2>
                        <ul class="search-recommendation-list"></ul>
                    </div>
                    <div class="search-recommendation-group search-top-rated" hidden>
                        <h2>Top rated</h2>
                        <ul class="search-recommendation-list"></ul>
                    </div>
                    <div class="search-recommendation-group search-matches" hidden>
                        <h2>Suggestions</h2>
                        <ul class="search-recommendation-list"></ul>
                        <p class="search-recommendation-empty" hidden>No matching menu items.</p>
                    </div>
                </div>
            </div>

            <div class="active-search" hidden>
                <button type="button" class="active-search-query"></button>
                <button type="button" class="clear-search" aria-label="Clear search">&times;</button>
            </div>
        </div>

        <button type="button" class="filter-pill active" data-category="all">All</button>

        @foreach (var type in Enum.GetValues<MenuItemType>())
        {
            <button type="button" class="filter-pill" data-category="@type.ToString().ToLower()">@type</button>
        }
    </nav>

    @if (Model.Items.Count == 0)
    {
        <p class="menu-empty-state">Our menu is being updated. Please check back soon.</p>
    }

    <div class="menu-grid">
        @foreach (var item in Model.Items)
        {
            <a asp-page="/Menu/Item"
               asp-route-menuItemId="@item.Id"
               class="item-card-link text-decoration-none text-reset"
               data-category="@item.MenuItemType.ToString().ToLower()"
               data-search-name="@item.Name"
               data-top-rated-order="@Model.TopRatedMenuItemIds.IndexOf(item.Id)">

                <div class="item-card">
                    <div class="thumbnail-container">
                        @if (!string.IsNullOrWhiteSpace(item.ThumbnailImage))
                        {
                            <img class="thumbnail-img" src="@Url.Content(item.ThumbnailImage)" alt="@item.Name" />
                        }
                        else
                        {
                            <i class="fa-solid @(item.MenuItemType == MenuItemType.Beverage ? "fa-martini-glass-citrus" : "fa-utensils") thumbnail-placeholder" aria-hidden="true"></i>
                        }
                        <span class="category">
                            <i class="fa-solid @(item.MenuItemType == MenuItemType.Beverage ? "fa-martini-glass-citrus" : "fa-utensils")" aria-hidden="true"></i>
                            @item.MenuItemType
                        </span>
                    </div>

                    <div class="info-container">
                        <h3 class="item-title">@item.Name</h3>
                        <div class="bottom-section">
                            <span class="price">@Model.Currency.FormatCents(item.Price)</span>
                            <span class="item-link-hint" aria-hidden="true">
                                <i class="fa-solid fa-arrow-up-right-from-square"></i>
                            </span>
                        </div>
                    </div>
                </div>
            </a>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/tableMenu.js" asp-append-version="true"></script>
}
