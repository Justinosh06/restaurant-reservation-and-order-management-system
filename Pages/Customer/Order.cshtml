@page "{id}"
@using RestaurantReservation.Extensions
@using RestaurantReservation.Models
@model Restaurant_Reservation_and_Order_Management_System.Pages.Customer.OrderModel
@{
    ViewData["Title"] = $"Order #{Model.Order.Id}";

    // Order and session times are stored in UTC.
    DateTime ToLocal(DateTime utc) => DateTime.SpecifyKind(utc, DateTimeKind.Utc).ToLocalTime();

    string ItemName(string menuItemId) =>
        Model.Items.FirstOrDefault(i => i.MenuItemId == menuItemId)?.ItemName ?? menuItemId;

    // Read-only stars for a rating from 1 to 5.
    void Stars(int rating)
    {
        <span class="review-stars" aria-label="@rating out of 5">
            @for (var star = 1; star <= 5; star++)
            {
                <i class="@(star <= rating ? "fa-solid" : "fa-regular") fa-star"></i>
            }
        </span>
    }
}

<section class="detail-page">
    <a asp-page="/Customer/Dining/Visit" asp-route-id="@Model.Order.SessionId" class="back-link"><i class="fa-solid fa-arrow-left me-1"></i> Back to dining visit</a>

    <div class="order-head">
        <h1 class="section-title">Order #@Model.Order.Id</h1>
        <span class="status-pill @(Model.Order.Status == OrderStatus.Cancelled ? "muted" : "")">@Model.Order.Status</span>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <p class="notice">@Model.SuccessMessage</p>
    }

    <dl class="order-meta">
        <div>
            <dt>Started</dt>
            <dd>@ToLocal(Model.Order.CreatedAt).ToString("d MMM yyyy, HH:mm")</dd>
        </div>
        <div>
            <dt>Items</dt>
            <dd>@Model.Items.Sum(i => i.Quantity)</dd>
        </div>
    </dl>

    <form method="post" class="order-card-box">
        <ul class="order-items">
            @foreach (var item in Model.Items)
            {
                var price = item.UnitPrice;
                var index = Model.Feedback.FindIndex(f => f.MenuItemId == item.MenuItemId);
                // An item ordered twice gets one feedback box, under its first line.
                var firstLine = item == Model.Items.First(i => i.MenuItemId == item.MenuItemId);
                var showFeedback = index >= 0 && firstLine;
                var showLocked = firstLine && item.MenuItemId is not null && Model.Locked.Contains(item.MenuItemId);

                <li class="order-item">
                    @if (!string.IsNullOrEmpty(item.MenuItem?.ThumbnailImage))
                    {
                        <img src="@Url.Content(item.MenuItem.ThumbnailImage)" alt="" />
                    }
                    else
                    {
                        <span class="item-img-blank"></span>
                    }

                    <div>
                        <strong class="item-name">@item.ItemName</strong>
                        <partial name="_ItemOptions" model="new IReadOnlyDictionary<string, string>[] { item.Options }" />
                        @if (!string.IsNullOrWhiteSpace(item.Remarks))
                        {
                            <span class="hint d-block">Note: @item.Remarks</span>
                        }
                        <span class="menu-price">@Model.Currency.FormatCents(price) &times; @item.Quantity</span>
                    </div>

                    <strong class="item-total">@Model.Currency.FormatCents(price * item.Quantity)</strong>

                    @if (showLocked)
                    {
                        var given = Model.Previous[item.MenuItemId!];

                        @* Feedback already given on this order (or a later one) can no longer be changed here. *@
                        <div class="item-feedback feedback-given">
                            <div class="feedback-given-head">
                                <span class="hint">
                                    @(given.OrderId == Model.Order.Id ? "Your feedback" : "You reviewed this dish on a later order")
                                </span>
                                @{ Stars(given.Rating); }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(given.Description))
                            {
                                <p class="mb-0">@given.Description</p>
                            }
                        </div>
                    }
                    else if (showFeedback)
                    {
                        var input = Model.Feedback[index];

                        <div class="item-feedback">
                            <input type="hidden" name="Feedback[@index].MenuItemId" value="@input.MenuItemId" />

                            <div class="star-input" role="radiogroup" aria-label="Rating for @item.ItemName">
                                @for (var star = 5; star >= 1; star--)
                                {
                                    <input type="radio" class="star-radio" id="rating-@index-@star" name="Feedback[@index].Rating"
                                           value="@star" checked="@(input.Rating == star)" />
                                    <label class="star" for="rating-@index-@star" title="@star out of 5">
                                        <i class="fa-solid fa-star"></i>
                                    </label>
                                }
                                <input type="radio" id="rating-@index-none" name="Feedback[@index].Rating" value="" />
                                <label class="star-clear" for="rating-@index-none">Clear</label>
                            </div>

                            <textarea name="Feedback[@index].Description" rows="2" maxlength="300"
                                      placeholder="Tell us about this dish (optional)"
                                      aria-label="Comment on @item.ItemName">@input.Description</textarea>

                            @if (Model.Errors.TryGetValue(input.MenuItemId, out var error))
                            {
                                <span class="field-error">@error</span>
                            }
                        </div>
                    }
                </li>
            }
        </ul>

        <div class="order-total-line">
            <span>Total</span>
            <strong>@Model.Currency.FormatCents(Model.Order.TotalAmount)</strong>
        </div>

        @if (Model.Feedback.Count > 0)
        {
            <div class="order-actions">
                <span class="hint">Feedback is optional. Rate only the items you want to.</span>
                <button type="submit" class="pill-btn">Send feedback</button>
            </div>
        }
        else if (!Model.CanReview)
        {
            <p class="hint mb-0">Feedback can be left once an order has been served.</p>
        }

        @if (Model.Conflicts.Count > 0)
        {
            @* Reminder before replacing earlier feedback. Nothing is saved until the customer chooses. *@
            <div class="modal fade" id="overwriteModal" tabindex="-1" aria-labelledby="overwriteModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h2 class="modal-title h5" id="overwriteModalLabel">Replace your earlier feedback?</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p class="mb-3">
                                You have reviewed @(Model.Conflicts.Count == 1 ? "this dish" : "these dishes") before.
                                Each dish keeps only one review from you. Click the feedback you want to keep.
                            </p>

                            <ul class="overwrite-list">
                                @foreach (var conflict in Model.Conflicts)
                                {
                                    var earlier = Model.Previous[conflict.MenuItemId];

                                    <li>
                                        <strong class="d-block mb-2">@ItemName(conflict.MenuItemId)</strong>

                                        @* Clicking a box picks it; the earlier feedback is picked to start with. *@
                                        <div class="overwrite-compare" role="radiogroup" aria-label="Which feedback to keep for @ItemName(conflict.MenuItemId)">
                                            <label class="overwrite-option">
                                                <input type="radio" name="OverwriteChoice[@conflict.MenuItemId]" value="keep" checked />
                                                <span class="overwrite-option-head">
                                                    <span class="hint">Earlier feedback</span>
                                                    <i class="fa-solid fa-circle-check"></i>
                                                </span>
                                                @{ Stars(earlier.Rating); }
                                                <p class="mb-0">@(string.IsNullOrWhiteSpace(earlier.Description) ? "No comment" : earlier.Description)</p>
                                            </label>
                                            <label class="overwrite-option">
                                                <input type="radio" name="OverwriteChoice[@conflict.MenuItemId]" value="replace" />
                                                <span class="overwrite-option-head">
                                                    <span class="hint">New feedback</span>
                                                    <i class="fa-solid fa-circle-check"></i>
                                                </span>
                                                @{ Stars(conflict.Rating ?? 0); }
                                                <p class="mb-0">@(string.IsNullOrWhiteSpace(conflict.Description) ? "No comment" : conflict.Description)</p>
                                            </label>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="pill-btn ghost" data-bs-dismiss="modal">Go back</button>
                            <button type="submit" name="ConfirmOverwrite" value="true" class="pill-btn">Save my choices</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </form>
</section>

@section Scripts {
    @if (Model.Conflicts.Count > 0)
    {
        <script>
            // The reminder opens straight away when Send feedback finds earlier feedback.
            new bootstrap.Modal(document.getElementById('overwriteModal')).show();
        </script>
    }
}
