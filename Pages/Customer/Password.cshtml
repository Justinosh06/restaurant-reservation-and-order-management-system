@page
@model Restaurant_Reservation_and_Order_Management_System.Pages.Customer.PasswordModel
@{
    ViewData["Title"] = "Password";
}

<section class="profile">
    <h1 class="section-title">Password</h1>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <p class="notice">@Model.SuccessMessage</p>
    }

    @if (!Model.IsChanging)
    {
        <div class="profile-grid single">
            <div class="profile-field">
                <span class="field-label">Password</span>
                @if (Model.HasPassword)
                {
                    <span class="field-value">&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;</span>
                }
                else
                {
                    <span class="field-value">Not set</span>
                }
            </div>
            <p class="hint mb-0">
                @(Model.HasPassword
                    ? "Keep your account safe by using a password you do not use anywhere else."
                    : "You log in with a code sent to your email. Set a password if you would rather log in with it.")
            </p>

            <form method="get" class="profile-actions">
                <button type="submit" name="change" value="true" class="pill-btn">@(Model.HasPassword ? "Change password" : "Set password")</button>
            </form>
        </div>
    }
    else
    {
        <form method="post" id="passwordForm" class="profile-grid single">
            <div asp-validation-summary="ModelOnly" class="field-error"></div>

            @if (Model.WrongCurrentPassword)
            {
                <p class="field-error mb-0" role="alert">
                    Your current password is incorrect. If you have forgotten it, please email
                    <a href="mailto:@PasswordModel.AdminEmail">@PasswordModel.AdminEmail</a> to request a password reset.
                </p>
            }

            @* No current password to type when the account has none yet. *@
            @if (Model.HasPassword)
            {
                <div class="profile-field">
                    <label asp-for="Input.CurrentPassword" class="field-label">Current Password</label>
                    <div class="password-input">
                        <input asp-for="Input.CurrentPassword" autocomplete="current-password" />
                        <button type="button" class="password-toggle" aria-label="Show password" aria-pressed="false">
                            <i class="fa-regular fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.CurrentPassword" class="field-error"></span>
                </div>
            }

            <div class="profile-field">
                <label asp-for="Input.NewPassword" class="field-label">New Password</label>
                <div class="password-input">
                    <input asp-for="Input.NewPassword" autocomplete="new-password" />
                    <button type="button" class="password-toggle" aria-label="Show password" aria-pressed="false">
                        <i class="fa-regular fa-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Input.NewPassword" class="field-error"></span>
            </div>

            <div class="profile-field">
                <label asp-for="Input.ConfirmPassword" class="field-label">Confirm Password</label>
                <div class="password-input">
                    <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
                    <button type="button" class="password-toggle" aria-label="Show password" aria-pressed="false">
                        <i class="fa-regular fa-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
            </div>

            <p class="hint mb-0">At least 8 characters, with an uppercase letter, a lowercase letter and a number.</p>

            <div class="profile-actions">
                <a asp-page="/Customer/Password" class="pill-btn ghost">Cancel</a>
                <button type="button" id="changeButton" class="pill-btn">@(Model.HasPassword ? "Change password" : "Set password")</button>
            </div>

            <!-- CAPTCHA step: opens after the Change password button is clicked -->
            <div class="modal fade" id="captchaModal" tabindex="-1" aria-labelledby="captchaModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h2 class="modal-title h5" id="captchaModalLabel">Security Check</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p class="mb-2">Type the characters shown in the image to confirm you are not a robot.</p>
                            <div class="d-flex align-items-center flex-wrap gap-2 mb-3">
                                <img id="captchaImage" alt="CAPTCHA image" width="200" height="70" class="border rounded" />
                                <button type="button" id="refreshCaptcha" class="btn btn-outline-secondary btn-sm">&#x21bb; New image</button>
                            </div>
                            <label asp-for="Input.CaptchaAnswer" class="form-label"></label>
                            <input asp-for="Input.CaptchaAnswer" class="form-control text-uppercase" autocomplete="off" maxlength="5" />
                            <div id="captchaError" class="text-danger small mt-1 d-none">Please enter the characters shown.</div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-dark">Verify &amp; @(Model.HasPassword ? "Change" : "Set")</button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.IsChanging)
    {
        <script>
            (function () {
                const form = document.getElementById('passwordForm');
                const changeButton = document.getElementById('changeButton');
                const modalElement = document.getElementById('captchaModal');
                const modal = new bootstrap.Modal(modalElement);
                const image = document.getElementById('captchaImage');
                const answer = document.getElementById('Input_CaptchaAnswer');
                const error = document.getElementById('captchaError');

                // Eye button: show or hide the password typed in the field beside it.
                document.querySelectorAll('.password-toggle').forEach(function (toggle) {
                    const input = toggle.previousElementSibling;
                    const icon = toggle.querySelector('i');

                    toggle.addEventListener('click', function () {
                        const show = input.type === 'password';
                        input.type = show ? 'text' : 'password';
                        icon.classList.toggle('fa-eye', !show);
                        icon.classList.toggle('fa-eye-slash', show);
                        toggle.setAttribute('aria-pressed', show);
                        toggle.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                        input.focus();
                    });
                });

                function loadCaptcha() {
                    answer.value = '';
                    image.src = '?handler=Captcha&t=' + Date.now();
                }

                // Change password button: check the password fields first, then show the CAPTCHA step.
                changeButton.addEventListener('click', function () {
                    if (!$(form).valid()) {
                        return;
                    }
                    error.classList.add('d-none');
                    loadCaptcha();
                    modal.show();
                });

                modalElement.addEventListener('shown.bs.modal', () => answer.focus());
                document.getElementById('refreshCaptcha').addEventListener('click', loadCaptcha);

                // Pressing Enter in the password fields opens the CAPTCHA instead of skipping it.
                form.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' && !modalElement.contains(e.target)) {
                        e.preventDefault();
                        changeButton.click();
                    }
                });

                form.addEventListener('submit', function (e) {
                    if (!answer.value.trim()) {
                        e.preventDefault();
                        error.classList.remove('d-none');
                    }
                });
            })();
        </script>
    }
}
