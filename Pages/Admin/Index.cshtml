@page
@{
    ViewData["Title"] = "Dashboard";
}

<div class="admin-page">
    <div class="admin-page-header">
        <div>
            <h2>Dashboard</h2>
            <p>Overview of today's restaurant activity</p>
        </div>
        <span class="text-muted small" id="dashboard-date"></span>
    </div>

    <div class="admin-grid mb-3">
        <div class="admin-card stat-tile span-3">
            <div class="stat-label"><i class="fa-solid fa-coins"></i> Revenue today</div>
            <div class="stat-value" id="kpi-revenue">-</div>
            <div class="stat-delta"><span class="up">+12.4%</span> vs yesterday</div>
        </div>
        <div class="admin-card stat-tile span-3">
            <div class="stat-label"><i class="fa-solid fa-receipt"></i> Orders today</div>
            <div class="stat-value" id="kpi-orders">-</div>
            <div class="stat-delta"><span class="up">+8</span> vs yesterday</div>
        </div>
        <div class="admin-card stat-tile span-3">
            <div class="stat-label"><i class="fa-solid fa-calendar-check"></i> Reservations today</div>
            <div class="stat-value" id="kpi-reservations">-</div>
            <div class="stat-delta"><span class="down">-3</span> vs yesterday</div>
        </div>
        <div class="admin-card stat-tile span-3">
            <div class="stat-label"><i class="fa-solid fa-chart-simple"></i> Avg. order value</div>
            <div class="stat-value" id="kpi-aov">-</div>
            <div class="stat-delta"><span class="up">+2.1%</span> vs yesterday</div>
        </div>
    </div>

    <div class="admin-grid mb-3">
        <div class="admin-card span-8">
            <div class="admin-card-title">Revenue, last 7 days</div>
            <div class="admin-card-subtitle">Daily total in RM</div>
            <div class="chart-box"><canvas id="chart-revenue" role="img" aria-label="Line chart of daily revenue over the last 7 days"></canvas></div>
        </div>
        <div class="admin-card span-4">
            <div class="admin-card-title">Today's orders by status</div>
            <div class="admin-card-subtitle">Number of orders</div>
            <div class="chart-box"><canvas id="chart-status" role="img" aria-label="Bar chart of today's orders by status"></canvas></div>
        </div>
    </div>

    <div class="admin-grid mb-3">
        <div class="admin-card span-6">
            <div class="admin-card-title">Orders by hour</div>
            <div class="admin-card-subtitle">Today, number of orders placed</div>
            <div class="chart-box"><canvas id="chart-hourly" role="img" aria-label="Bar chart of orders placed per hour today"></canvas></div>
        </div>
        <div class="admin-card span-6">
            <div class="admin-card-title">Top menu items</div>
            <div class="admin-card-subtitle">This week, units sold</div>
            <div class="chart-box"><canvas id="chart-items" role="img" aria-label="Bar chart of top selling menu items this week"></canvas></div>
        </div>
    </div>

    <div class="admin-card">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <div class="admin-card-title">Recent orders</div>
                <div class="admin-card-subtitle">Latest 5 orders</div>
            </div>
            <a asp-page="/Admin/Orders/Index" class="btn btn-sm btn-admin-light">View all</a>
        </div>
        <div class="table-scroll">
            <table class="admin-table">
                <thead>
                    <tr><th>Order</th><th>Table</th><th>Time</th><th>Total</th><th>Status</th></tr>
                </thead>
                <tbody id="recent-orders"></tbody>
            </table>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin/dashboard.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.min.js"></script>
    <script src="~/js/admin/admin-common.js" asp-append-version="true"></script>
    <script src="~/js/admin/dashboard.js" asp-append-version="true"></script>
}
