@page "/Admin/Announcements"
@model RestaurantReservation.Pages.Admin.Announcements.AnnouncementModel
@using RestaurantReservation.Infrastructure.Admin
@using RestaurantReservation.Models
@using RestaurantReservation.Pages.Admin.Announcements
@{
    ViewData["Title"] = "Announcements";
    var descriptionMax = ModelRules.MaxLength<Announcement>(nameof(Announcement.Description));
}

<div class="admin-page px-3 pt-3 pb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <h1 class="h4 fw-semibold mb-1">Announcements</h1>
        </div>
        <button type="button" class="btn btn-dark" id="btn-new-announcement"><i class="fa-solid fa-plus me-1"></i> New announcement</button>
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            <section class="card h-100 border-0 bg-body-tertiary rounded-4">
                <div class="d-flex flex-wrap align-items-center gap-2 px-3 pt-3 pb-2">
                    <span class="small text-body-secondary fw-medium">All announcements</span>
                    <div class="d-flex flex-wrap gap-2 ms-lg-auto">
                        <div class="input-group input-group-sm w-auto">
                            <span class="input-group-text bg-body"><i class="fa-solid fa-magnifying-glass text-body-secondary"></i></span>
                            <input type="search" id="ann-search" class="form-control" placeholder="Search by title" aria-label="Search announcements by title" />
                        </div>
                        <select class="form-select form-select-sm w-auto" id="ann-category-filter" aria-label="Filter by category">
                            <option value="">All categories</option>
                            @foreach (var category in AnnouncementModel.Categories)
                            {
                                <option value="@category.Name">@category.Name</option>
                            }
                        </select>
                        <select class="form-select form-select-sm w-auto" id="ann-status-filter" aria-label="Filter by status">
                            <option value="">All statuses</option>
                            <option value="Active">Active</option>
                            <option value="Hidden">Hidden</option>
                            <option value="Expired">Expired</option>
                        </select>
                    </div>
                </div>
                <div class="d-flex flex-column gap-1 p-1 pt-0" id="announcement-list"></div>
            </section>
        </div>

        <div class="col-lg-4">
            <section class="card border-0 bg-body-tertiary rounded-4">
                <div class="small text-body-secondary fw-medium px-3 pt-3 pb-2">Overview</div>
                <div class="card bg-body border-0 rounded-4 mx-1 overflow-hidden">
                    <ul class="list-group list-group-flush" id="ann-stats"></ul>
                </div>
                <div class="small text-body-secondary px-3 py-2" id="ann-updated"></div>
            </section>
        </div>
    </div>
</div>

<div class="modal fade" id="ann-modal" tabindex="-1" aria-labelledby="ann-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <form class="modal-content" id="announcement-form" data-today="@Model.Today.ToString("yyyy-MM-dd")" novalidate>
            <div class="modal-header">
                <h5 class="modal-title" id="ann-modal-title">New announcement</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="ann-id" />
                <div class="mb-3">
                    <label for="ann-title" class="form-label">Title</label>
                    <input type="text" class="form-control" id="ann-title" maxlength="@(ModelRules.MaxLength<Announcement>(nameof(Announcement.Title)))" required placeholder="e.g. Closed for Deepavali" />
                    <div class="invalid-feedback">Title is required.</div>
                </div>

                <div class="mb-3">
                    <label for="ann-description" class="form-label">Message</label>
                    <textarea class="form-control" id="ann-description" rows="4" maxlength="@descriptionMax" required placeholder="Write the announcement..."></textarea>
                    <div class="invalid-feedback">Message is required.</div>
                    <div class="form-text text-end" id="ann-char-count">0 / @descriptionMax</div>
                </div>

                <fieldset class="mb-3">
                    <legend class="form-label fs-6">Category</legend>
                    <div class="d-flex flex-wrap gap-2">
                        @for (var i = 0; i < AnnouncementModel.Categories.Count; i++)
                        {
                            var category = AnnouncementModel.Categories[i];
                            <input type="radio" class="btn-check" name="ann-category" id="ann-category-@i" value="@category.Name" checked="@(i == 0)" />
                            <label class="btn btn-outline-secondary btn-sm rounded-pill" for="ann-category-@i"><i class="@category.Icon me-1"></i>@category.Name</label>
                        }
                    </div>
                </fieldset>

                <div class="mb-3">
                    <label for="ann-expires" class="form-label">Show until <span class="text-body-secondary">(optional)</span></label>
                    <input type="date" class="form-control" id="ann-expires" aria-describedby="ann-expires-help" />
                    <div class="form-text" id="ann-expires-help">The announcement stays visible until the end of this day.</div>
                </div>

                <div class="form-check form-switch mb-1">
                    <input class="form-check-input" type="checkbox" role="switch" id="ann-active" checked />
                    <label class="form-check-label" for="ann-active">Visible to customers</label>
                </div>

                <div class="alert alert-danger d-none mt-3 mb-0" id="ann-form-error" role="alert"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-dark" id="ann-submit">Post announcement</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="ann-view-modal" tabindex="-1" aria-labelledby="ann-view-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ann-view-title">Announcement</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="ann-view-body"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/admin-common.js" asp-append-version="true"></script>
    <script src="~/js/admin/announcements.js" asp-append-version="true"></script>
}
