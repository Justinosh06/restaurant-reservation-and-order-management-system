@page
@{
    ViewData["Title"] = "Staffs";
}

<div class="admin-page">
    <div class="admin-page-header">
        <div>
            <h2>Staffs</h2>
            <p>Create and manage staff accounts. Staff can sign in right away, so they don't need to register.</p>
        </div>
        <button type="button" class="btn btn-admin" id="btn-add-staff"><i class="fa-solid fa-plus me-1"></i> Add staff</button>
    </div>

    <div class="admin-card">
        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
            <div>
                <div class="admin-card-title">Staff accounts</div>
                <div class="admin-card-subtitle mb-0" id="staff-count"></div>
            </div>
            <input type="search" id="staff-search" class="form-control" style="max-width: 240px" placeholder="Search by email" aria-label="Search staff" />
        </div>
        <div class="table-scroll">
            <table class="admin-table">
                <thead>
                    <tr><th>Staff ID</th><th>Email</th><th>Role</th><th class="text-end">Actions</th></tr>
                </thead>
                <tbody id="staff-body"></tbody>
            </table>
        </div>
        <div class="empty-state d-none" id="staff-empty">No staff accounts found.</div>
    </div>
</div>

<div class="modal fade" id="staff-modal" tabindex="-1" aria-labelledby="staff-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" id="staff-form" novalidate>
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-semibold" id="staff-modal-title">Add staff</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="staff-id" />
                <div class="mb-3">
                    <label for="staff-email" class="form-label">Email</label>
                    <input type="email" class="form-control" id="staff-email" required placeholder="name@resto.com" />
                    <div class="invalid-feedback">Please enter a valid email address that isn't already in use.</div>
                </div>
                <div class="mb-3">
                    <label for="staff-password" class="form-label">Password</label>
                    <div class="input-group">
                        <input type="password" class="form-control" id="staff-password" minlength="8" autocomplete="new-password" />
                        <button type="button" class="btn btn-admin-light" id="toggle-password" aria-label="Show password"><i class="fa-regular fa-eye"></i></button>
                        <div class="invalid-feedback">Password must be at least 8 characters.</div>
                    </div>
                    <div class="form-text" id="password-help">At least 8 characters. Share it with the staff member so they can sign in.</div>
                </div>
                <div class="mb-1">
                    <label for="staff-role" class="form-label">Role</label>
                    <select class="form-select" id="staff-role">
                        <option value="Staff">Staff</option>
                        <option value="Administrator">Administrator</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-admin-light" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-admin" id="staff-submit">Create account</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="delete-modal" tabindex="-1" aria-labelledby="delete-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-body p-4">
                <h5 class="fw-semibold" id="delete-modal-title">Delete staff account?</h5>
                <p class="text-muted mb-0"><span id="delete-email" class="fw-medium text-dark"></span> will no longer be able to sign in.</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-admin-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" style="border-radius: 10px" id="confirm-delete">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/admin-common.js" asp-append-version="true"></script>
    <script src="~/js/admin/staffs.js" asp-append-version="true"></script>
}
