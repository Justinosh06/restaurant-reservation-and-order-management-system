@page "/Admin/Menu"
@model RestaurantReservation.Pages.Admin.Menu.MenuModel
@using RestaurantReservation.Extensions
@using RestaurantReservation.Infrastructure.Admin
@using RestaurantReservation.Models
@using RestaurantReservation.Pages.Admin.Menu
@inject RestaurantCurrency Currency
@{
    ViewData["Title"] = "Menu";
    var maxImageMb = ImageUploadService.MaxImageBytes / (1024 * 1024);
    var descriptionMax = ModelRules.MaxLength<MenuItem>(nameof(MenuItem.Description));
    var currency = await Currency.GetAsync();
}

<div class="admin-page px-3 pt-3 pb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <h1 class="h4 fw-semibold mb-1">Menu</h1>
        </div>
        <button type="button" class="btn btn-dark" id="btn-new-item"><i class="fa-solid fa-plus me-1"></i> New menu item</button>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-xxl-3">
            <div class="card h-100 border-0 bg-body-tertiary rounded-4">
                <div class="card bg-body border-0 rounded-4 m-1">
                    <div class="card-body">
                        <div class="small text-body-secondary fw-medium">Menu items</div>
                        <div class="fs-4 fw-semibold" id="summary-total">-</div>
                    </div>
                </div>
                <div class="small text-body-secondary px-3 py-2">Everything on the menu</div>
            </div>
        </div>
        <div class="col-6 col-xxl-3">
            <div class="card h-100 border-0 bg-body-tertiary rounded-4">
                <div class="card bg-body border-0 rounded-4 m-1">
                    <div class="card-body">
                        <div class="small text-body-secondary fw-medium">Available</div>
                        <div class="fs-4 fw-semibold" id="summary-available">-</div>
                    </div>
                </div>
                <div class="small text-body-secondary px-3 py-2">Customers can order</div>
            </div>
        </div>
        <div class="col-6 col-xxl-3">
            <div class="card h-100 border-0 bg-body-tertiary rounded-4">
                <div class="card bg-body border-0 rounded-4 m-1">
                    <div class="card-body">
                        <div class="small text-body-secondary fw-medium">Unavailable</div>
                        <div class="fs-4 fw-semibold" id="summary-unavailable">-</div>
                    </div>
                </div>
                <div class="small text-body-secondary px-3 py-2">Hidden from ordering</div>
            </div>
        </div>
        <div class="col-6 col-xxl-3">
            <div class="card h-100 border-0 bg-body-tertiary rounded-4">
                <div class="card bg-body border-0 rounded-4 m-1">
                    <div class="card-body">
                        <div class="small text-body-secondary fw-medium">No photo</div>
                        <div class="fs-4 fw-semibold" id="summary-no-image">-</div>
                    </div>
                </div>
                <div class="small text-body-secondary px-3 py-2">Add one so dishes stand out</div>
            </div>
        </div>
    </div>

    <section class="card border-0 bg-body-tertiary rounded-4">
        <div class="d-flex flex-wrap align-items-center gap-3 px-4 pt-4 pb-3">
            <div class="d-inline-flex flex-wrap gap-1 bg-body rounded-pill p-1" role="group" aria-label="Filter by category" id="menu-category-filter">
                <button type="button" class="btn btn-sm rounded-pill px-3 btn-dark" data-category="" aria-pressed="true">All</button>
                @foreach (var category in MenuModel.Categories)
                {
                    <button type="button" class="btn btn-sm rounded-pill px-3" data-category="@category" aria-pressed="false">@category</button>
                }
            </div>

            <div class="d-flex flex-wrap gap-2 ms-lg-auto">
                <div class="input-group input-group-sm w-auto search-pill">
                    <span class="input-group-text"><i class="fa-solid fa-magnifying-glass text-body-secondary"></i></span>
                    <input type="search" id="menu-search" class="form-control" placeholder="Search by name" aria-label="Search menu items by name" />
                </div>
                <select class="form-select form-select-sm w-auto filter-pill" id="menu-availability-filter" aria-label="Filter by availability">
                    <option value="">All items</option>
                    <option value="available">Available</option>
                    <option value="unavailable">Unavailable</option>
                </select>
            </div>
        </div>
        <div class="row g-3 px-4 pb-4" id="menu-grid"></div>
    </section>
</div>

<div class="modal fade" id="menu-modal" tabindex="-1" aria-labelledby="menu-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <form class="modal-content" id="menu-form" novalidate>
            <div class="modal-header">
                <h5 class="modal-title" id="menu-modal-title">New menu item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="menu-id" />
                <div class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label" for="menu-image">Photo <span class="text-body-secondary">(optional)</span></label>
                        <div class="ratio ratio-4x3 border border-2 rounded-3 bg-body-tertiary overflow-hidden" id="menu-image-drop" tabindex="0" role="button" aria-label="Upload menu item photo">
                            <div class="d-flex flex-column align-items-center justify-content-center text-body-secondary">
                                <i class="fa-regular fa-image fs-3 mb-1"></i>
                                <span class="small">Click or drop an image here</span>
                            </div>
                        </div>
                        <input type="file" id="menu-image" class="d-none"
                               accept="@ImageUploadService.AcceptAttribute"
                               data-max-bytes="@ImageUploadService.MaxImageBytes" />
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <small class="form-text">JPG, PNG or WebP, up to @maxImageMb MB</small>
                            <button type="button" class="btn btn-link link-danger btn-sm p-0 d-none" id="menu-remove-image">Remove</button>
                        </div>
                        <small class="text-danger" id="menu-image-error"></small>

                        <div class="form-check form-switch mt-3">
                            <input class="form-check-input" type="checkbox" role="switch" id="menu-available" checked />
                            <label class="form-check-label" for="menu-available">Available to order</label>
                        </div>
                    </div>

                    <div class="col-md-7">
                        <div class="mb-3">
                            <label for="menu-name" class="form-label">Name</label>
                            <input type="text" class="form-control" id="menu-name" required
                                   maxlength="@(ModelRules.MaxLength<MenuItem>(nameof(MenuItem.Name)))" placeholder="e.g. Carbonara" />
                            <div class="invalid-feedback">Name is required.</div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label for="menu-category" class="form-label">Category</label>
                                <select class="form-select" id="menu-category" required>
                                    @foreach (var category in MenuModel.Categories)
                                    {
                                        <option value="@category">@category</option>
                                    }
                                </select>
                            </div>
                            <div class="col-6">
                                <label for="menu-price" class="form-label">Price</label>
                                <div class="input-group has-validation">
                                    <span class="input-group-text">@currency.GetSymbol()</span>
                                    <input type="number" class="form-control" id="menu-price" required min="0" max="@MenuModel.MaxPrice" step="0.01" inputmode="decimal" placeholder="0.00" />
                                    <div class="invalid-feedback">Enter a price from 0 to @MenuModel.MaxPrice.ToString("N0"), with up to 2 decimals.</div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="menu-description" class="form-label">Description <span class="text-body-secondary">(optional)</span></label>
                            <textarea class="form-control" id="menu-description" rows="3" maxlength="@descriptionMax" placeholder="What's in it, how it's served..."></textarea>
                            <div class="form-text text-end" id="menu-char-count">0 / @descriptionMax</div>
                        </div>
                    </div>
                </div>

                <fieldset class="border-top pt-3 mt-1">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <legend class="form-label fs-6 mb-0 w-auto">Options <span class="text-body-secondary">(optional)</span></legend>
                        <button type="button" class="btn btn-sm btn-light border" id="menu-add-option"
                                data-max="@MenuModel.MaxOptions"><i class="fa-solid fa-plus me-1"></i>Add option</button>
                    </div>
                    <p class="form-text mt-0">e.g. Size: Regular, Large</p>
                    <div class="d-flex flex-column gap-2" id="menu-options"
                         data-name-max="@MenuModel.MaxOptionNameLength"></div>
                </fieldset>

                <div class="alert alert-danger d-none mt-3 mb-0" id="menu-form-error" role="alert"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-dark" id="menu-submit">Add to menu</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/admin-common.js" asp-append-version="true"></script>
    <script src="~/js/admin/menu.js" asp-append-version="true"></script>
}
