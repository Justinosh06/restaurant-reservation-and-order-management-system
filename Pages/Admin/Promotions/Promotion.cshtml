@page "/Admin/Promotions"
@model RestaurantReservation.Pages.Admin.Promotions.PromotionModel
@using RestaurantReservation.Infrastructure.Admin
@using RestaurantReservation.Models
@{
    ViewData["Title"] = "Promotion";
    var maxImageMb = RestaurantReservation.Pages.Admin.Promotions.PromotionModel.MaxImageBytes / (1024 * 1024);
}

<div class="admin-page">
    <div class="page-header d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <div>
            <h1 class="page-title">Promotion</h1>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-5">
            <form class="card" id="promo-form" novalidate>
                <div class="card-header">New promotion</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label" for="promo-image">Image</label>
                        <div class="image-drop border rounded bg-body-tertiary d-flex flex-column align-items-center justify-content-center text-muted"
                             id="image-drop" tabindex="0" role="button" aria-label="Upload promotion image">
                            <i class="fa-regular fa-image fs-3"></i>
                            <span>Click or drop an image here</span>
                        </div>
                        <input type="file" id="promo-image" class="d-none"
                               accept="@string.Join(", ", RestaurantReservation.Pages.Admin.Promotions.PromotionModel.AllowedImageTypes.Keys)"
                               data-max-bytes="@RestaurantReservation.Pages.Admin.Promotions.PromotionModel.MaxImageBytes" />
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <small class="form-text">JPG, PNG or WebP, up to @maxImageMb MB</small>
                            <button type="button" class="btn btn-link btn-sm p-0 d-none" id="remove-image">Remove image</button>
                        </div>
                        <small class="text-danger" id="image-error"></small>
                    </div>

                    <div class="mb-3">
                        <label for="promo-title" class="form-label">Title</label>
                        <input type="text" class="form-control" id="promo-title" maxlength="@(ModelRules.MaxLength<Promotion>(nameof(Promotion.Title)))" required placeholder="e.g. Pasta Tuesday 20% off" />
                        <div class="invalid-feedback">Title is required.</div>
                    </div>

                    <div class="mb-3">
                        <label for="promo-description" class="form-label">Description</label>
                        <textarea class="form-control" id="promo-description" rows="3" maxlength="@(ModelRules.MaxLength<Promotion>(nameof(Promotion.Description)))" required placeholder="Describe the promotion and its terms..."></textarea>
                        <div class="invalid-feedback">Description is required.</div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label for="promo-start" class="form-label">Start date</label>
                            <input type="date" class="form-control" id="promo-start" required />
                            <div class="invalid-feedback">Start date is required.</div>
                        </div>
                        <div class="col-6">
                            <label for="promo-end" class="form-label">End date</label>
                            <input type="date" class="form-control" id="promo-end" required />
                            <div class="invalid-feedback">End date must be on or after the start date.</div>
                        </div>
                    </div>

                    <div class="alert alert-danger d-none" id="promo-form-error" role="alert"></div>
                    <button type="submit" class="btn btn-primary w-100" id="promo-submit"><i class="fa-solid fa-plus me-1"></i> Create promotion</button>
                </div>
            </form>
        </div>

        <div class="col-lg-7">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span>All promotions</span>
                <small class="text-muted" id="promo-count"></small>
            </div>
            <div class="row row-cols-1 row-cols-md-2 g-3" id="promo-list"></div>
            <p class="text-center text-muted py-4 d-none" id="promo-message"></p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/admin-common.js" asp-append-version="true"></script>
    <script src="~/js/admin/promotions.js" asp-append-version="true"></script>
}
