@page
@model Restaurant_Reservation_and_Order_Management_System.Pages.Admin.SignInModel
@{
    ViewData["Title"] = "Sign-in link expired";
    Layout = "_Layout";
}

<div class="text-center py-5">
    <h1 class="h3">Sign-in link expired</h1>
    <p class="text-muted">This sign-in link has already been used or is no longer valid.</p>
    <a href="@Model.LoginUrl" class="btn btn-primary">Log in again</a>
</div>
