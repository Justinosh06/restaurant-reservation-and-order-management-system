@page "/Admin/Profile"
@model RestaurantReservation.Pages.Admin.Profile.ProfileModel
@using RestaurantReservation.Infrastructure.Admin
@using RestaurantReservation.Models
@{
    ViewData["Title"] = "Profile";
    var account = Model.Account;
    var avatarGender = account.Gender == RestaurantReservation.Models.Enums.Gender.Female ? "female" : "male";
}

<div class="admin-page px-3 pt-3 pb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <h1 class="h4 fw-semibold mb-1">Profile</h1>
            <p class="small text-body-secondary mb-0">How your account appears in the admin portal.</p>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-4">
            <section class="card border-0 bg-body-tertiary rounded-4">
                <div class="card bg-body border-0 rounded-4 m-1">
                    <div class="card-body text-center py-4">
                        <div class="avatar mx-auto mb-3 border @avatarGender" style="width: 112px; height: 112px;">
                            <img class="avatar-img" src="~/images/avatar-@(avatarGender).png" alt="" />
                        </div>
                        <div class="fw-semibold fs-5 text-truncate" id="profile-summary-name">@(string.IsNullOrWhiteSpace(account.Name) ? "No name set" : account.Name)</div>
                        <div class="small text-body-secondary text-truncate" id="profile-summary-email">@account.Email</div>
                    </div>
                </div>
                <ul class="list-unstyled small text-body-secondary px-3 py-2 mb-0 d-flex flex-column gap-1">
                    <li><i class="fa-solid fa-user-tag fa-fw me-1"></i>@account.Role</li>
                    <li><i class="fa-solid fa-hashtag fa-fw me-1"></i>@AdminDisplay.ShortId(account.Id)</li>
                </ul>
            </section>
        </div>

        <div class="col-lg-8">
            <section class="card border-0 bg-body-tertiary rounded-4">
                <div class="small text-body-secondary fw-medium px-3 pt-3 pb-2">Account details</div>
                <form class="card bg-body border-0 rounded-4 m-1" id="profile-form" novalidate>
                    <div class="card-body">
                        <div class="mb-3">
                            <label for="profile-name" class="form-label">Name</label>
                            <input type="text" class="form-control" id="profile-name" value="@account.Name"
                                   maxlength="@(ModelRules.MaxLength<Admin>(nameof(Admin.Name)))" placeholder="e.g. Aisyah Rahman" autocomplete="name" />
                            <div class="form-text">Shown in the sidebar. Leave blank to show your role instead.</div>
                        </div>

                        <div class="mb-3">
                            <label for="profile-email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="profile-email" value="@account.Email" required
                                   maxlength="@(ModelRules.MaxLength<Admin>(nameof(Admin.Email)))" autocomplete="email" />
                            <div class="invalid-feedback">Please enter a valid email address.</div>
                            <div class="form-text">You sign in with this email.</div>
                        </div>

                        <div class="alert alert-danger d-none mb-3" id="profile-form-error" role="alert"></div>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="reset" class="btn btn-outline-secondary" id="profile-reset">Discard changes</button>
                            <button type="submit" class="btn btn-dark" id="profile-submit">Save changes</button>
                        </div>
                    </div>
                </form>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/admin-common.js" asp-append-version="true"></script>
    <script src="~/js/admin/profile.js" asp-append-version="true"></script>
}
