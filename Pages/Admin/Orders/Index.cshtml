@page
@{
    ViewData["Title"] = "Orders";
}

<div class="admin-page">
    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4">
        <div>
            <h2 class="mb-0">Orders</h2>
            <p class="text-muted mb-0">Track each order from Pending to Served</p>
        </div>
        <input type="search" id="order-search" class="form-control w-auto" placeholder="Search order, table or customer" aria-label="Search orders" />
    </div>

    <!-- Status filter (buttons rendered by orders.js) -->
    <div class="btn-group mb-3" id="status-filter" role="group" aria-label="Filter orders by status"></div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Table</th>
                        <th>Customer</th>
                        <th>Items</th>
                        <th>Time</th>
                        <th>Total</th>
                        <th>Progress</th>
                        <th>Status</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody id="orders-body"></tbody>
            </table>
        </div>
        <p class="text-center text-muted py-4 mb-0 d-none" id="orders-empty">No orders match this filter.</p>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin/orders.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/admin/admin-common.js" asp-append-version="true"></script>
    <script src="~/js/admin/orders.js" asp-append-version="true"></script>
}
