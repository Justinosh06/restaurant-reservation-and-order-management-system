@page
@model RestaurantReservation.Pages.Admin.Orders.IndexModel
@{
    ViewData["Title"] = "Orders";
}

<div class="admin-page">
    <div class="page-header">
        <div>
            <h1 class="page-title">Orders</h1>
        </div>
        <input type="search" id="order-search" class="form-control page-search" placeholder="Search order, table or customer" aria-label="Search orders" />
    </div>

    <div class="btn-group mb-3" id="status-filter" role="group" aria-label="Filter orders by status"></div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover table-fixed align-middle mb-0" style="--table-min-width: 1064px">
                <colgroup>
                    <col style="width: 110px" />
                    <col style="width: 72px" />
                    <col style="width: 180px" />
                    <col />
                    <col style="width: 96px" />
                    <col style="width: 110px" />
                    <col style="width: 120px" />
                    <col style="width: 110px" />
                    <col style="width: 170px" />
                </colgroup>
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Table</th>
                        <th>Customer</th>
                        <th>Items</th>
                        <th>Time</th>
                        <th>Total</th>
                        <th>Progress</th>
                        <th>Status</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody id="orders-body"></tbody>
            </table>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin/orders.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/admin/admin-common.js" asp-append-version="true"></script>
    <script src="~/js/admin/orders.js" asp-append-version="true"></script>
}
