@page
@{
    ViewData["Title"] = "Orders";
}

<div class="admin-page">
    <div class="page-header">
        <div>
            <h1 class="page-title">Orders</h1>
            <p class="page-subtitle">Track each order from Pending to Served</p>
        </div>
        <input type="search" id="order-search" class="form-control page-search" placeholder="Search order, table or customer" aria-label="Search orders" />
    </div>

    <!-- Status filter (buttons rendered by orders.js) -->
    <div class="btn-group mb-3" id="status-filter" role="group" aria-label="Filter orders by status"></div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover table-fixed align-middle mb-0" style="--table-min-width: 1040px">
                <colgroup>
                    <col style="width: 110px" />  @* Order *@
                    <col style="width: 72px" />   @* Table *@
                    <col style="width: 150px" />  @* Customer *@
                    <col />                       @* Items (takes the remaining space) *@
                    <col style="width: 72px" />   @* Time *@
                    <col style="width: 110px" />  @* Total *@
                    <col style="width: 120px" />  @* Progress *@
                    <col style="width: 110px" />  @* Status *@
                    <col style="width: 170px" />  @* Action *@
                </colgroup>
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Table</th>
                        <th>Customer</th>
                        <th>Items</th>
                        <th>Time</th>
                        <th>Total</th>
                        <th>Progress</th>
                        <th>Status</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody id="orders-body"></tbody>
            </table>
        </div>
        <p class="text-center text-muted py-4 mb-0 d-none" id="orders-empty">No orders match this status or search. Try another status or clear the search box.</p>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin/orders.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/admin/admin-common.js" asp-append-version="true"></script>
    <script src="~/js/admin/orders.js" asp-append-version="true"></script>
}
