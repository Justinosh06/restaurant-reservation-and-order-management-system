@page "/Admin/Orders"
@model RestaurantReservation.Pages.Admin.Orders.OrderModel
@{
    ViewData["Title"] = "Orders";
}

<div class="admin-page">
    <div class="page-header d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <div>
            <h1 class="page-title">Orders</h1>
        </div>
        <input type="search" id="order-search" class="form-control page-search w-auto" placeholder="Search order, table or customer" aria-label="Search orders" />
    </div>

    <div class="btn-group mb-3" id="status-filter" role="group" aria-label="Filter orders by status"></div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Table</th>
                        <th>Customer</th>
                        <th>Items</th>
                        <th>Time</th>
                        <th>Total</th>
                        <th>Progress</th>
                        <th>Status</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody id="orders-body"></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/admin-common.js" asp-append-version="true"></script>
    <script src="~/js/admin/orders.js" asp-append-version="true"></script>
}
