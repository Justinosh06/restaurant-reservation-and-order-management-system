@page "/Admin"
@model RestaurantReservation.Pages.Admin.Dashboard.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="admin-page px-3 pb-4">
    <div class="page-header d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <div>
            <h1 class="page-title">Dashboard</h1>
            <p class="page-subtitle">Overview of today's restaurant activity</p>
        </div>
        <small class="text-muted" id="dashboard-date"></small>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-sm-6 col-lg-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small" title="From served and completed orders"><i class="fa-solid fa-coins me-1"></i> Revenue today</div>
                    <div class="fs-3 fw-semibold kpi-value" id="kpi-revenue">-</div>
                    <small class="text-muted" id="kpi-revenue-delta">&nbsp;</small>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small"><i class="fa-solid fa-receipt me-1"></i> Orders today</div>
                    <div class="fs-3 fw-semibold kpi-value" id="kpi-orders">-</div>
                    <small class="text-muted" id="kpi-orders-delta">&nbsp;</small>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small"><i class="fa-solid fa-calendar-check me-1"></i> Reservations today</div>
                    <div class="fs-3 fw-semibold kpi-value" id="kpi-reservations">-</div>
                    <small class="text-muted" id="kpi-reservations-delta">&nbsp;</small>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small" title="From served and completed orders"><i class="fa-solid fa-chart-simple me-1"></i> Avg. order value</div>
                    <div class="fs-3 fw-semibold kpi-value" id="kpi-aov">-</div>
                    <small class="text-muted" id="kpi-aov-delta">&nbsp;</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-lg-8">
            <div class="card h-100">
                <div class="card-header"><span>Revenue from served orders, last 7 days (<span id="revenue-currency"></span>)</span></div>
                <div class="card-body">
                    <div class="chart-box"><canvas id="chart-revenue" role="img" aria-label="Line chart of daily revenue over the last 7 days"></canvas></div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header">Today's orders by status</div>
                <div class="card-body">
                    <div class="chart-box"><canvas id="chart-status" role="img" aria-label="Bar chart of today's orders by status"></canvas></div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">Orders by hour (today)</div>
                <div class="card-body">
                    <div class="chart-box"><canvas id="chart-hourly" role="img" aria-label="Bar chart of orders placed per hour today"></canvas></div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">Top menu items (units served, last 7 days)</div>
                <div class="card-body">
                    <div class="chart-box"><canvas id="chart-items" role="img" aria-label="Bar chart of top selling menu items in the last 7 days"></canvas></div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>Recent orders</span>
            <a asp-page="/Admin/Orders/Order" class="btn btn-sm btn-outline-primary">View all</a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr><th>Order</th><th>Table</th><th>Time</th><th>Total</th><th>Status</th></tr>
                </thead>
                <tbody id="recent-orders"></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.min.js"></script>
    <script src="~/js/admin/admin-common.js" asp-append-version="true"></script>
    <script src="~/js/admin/dashboard.js" asp-append-version="true"></script>
}
