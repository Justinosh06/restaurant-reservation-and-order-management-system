@page "/Table/{tableId}/Cart"
@using RestaurantReservation.Models.Enums
@model RestaurantReservation.Pages.Table.CartModel
@{
    ViewData["Title"] = $"Table {Model.TableId} Cart";
    ViewData["CartItemCount"] = Model.CartItems.Sum(i => i.Quantity);
    double subtotal = Model.CartItems.Sum(i => i.UnitPrice * i.Quantity);
    double discount = 0.00;
    double total = subtotal - discount;

    var menuItems = new[]
    {
        new { Id = "SPAG-01", Name = "Spaghetti Bolognaise", Price = "RM 24.90", Type = MenuItemType.Pasta, ImageUrl = "/image/Menu/matcha.png" },
        new { Id = "PAST-02", Name = "Creamy Carbonara", Price = "RM 22.50", Type = MenuItemType.Pasta, ImageUrl = "/image/Menu/matcha.png" },
        new { Id = "BEV-01", Name = "Iced Cappuccino", Price = "RM 12.90", Type = MenuItemType.Beverage, ImageUrl = "/image/Menu/matcha.png" },
        new { Id = "BEV-02", Name = "Matcha Latte", Price = "RM 14.00", Type = MenuItemType.Beverage, ImageUrl = "/image/Menu/matcha.png" }
    };
}

<link rel="stylesheet" href="~/css/cart_page.css">

<div class="cart-container">
    <h1 class="page-title">Your Cart</h1>

    <div class="content-container">
        <div class="item-container">
            <h5 class="cart-item-title">
                Cart Items <span class="cart-item-count" id="cart-item-count">@Model.CartItems.Sum(i => i.Quantity)</span>
            </h5>

            <div class="cart-column">
                @foreach (var item in Model.CartItems)
                {
                    <div class="item-card" data-item-id="@item.Id" data-price="@item.UnitPrice">
                        <div class="thumbnail-container">
                            <img class="thumbnail-img" src="@item.ImageUrl" alt="@item.Name" />
                        </div>

                        <div class="info-container">
                            <div class="top-section">
                                <h3 class="item-title">@item.Name</h3>
                                <span class="category">
                                    @if(@item.Type.ToString() == "Beverage")
                                    {
                                        <i class="fa-solid fa-martini-glass-citrus"></i>
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-utensils me-1"></i>
                                    }
                                    @item.Type.ToString()
                                </span>
                            </div>

                            @if (!string.IsNullOrEmpty(item.Remark))
                            {
                                <small class="text-muted">
                                    <i class="fa-regular"></i>@item.Remark
                                </small>
                            }

                            <span class="price mt-1">RM @item.UnitPrice.ToString("F2")</span>
                        </div>

                        <div class="quantity-wrapper">
                            <button type="button" class="quantity-btn btn-decrease">
                                <i class="fa-solid fa-minus"></i>
                            </button>
                            <span class="quantity-val fw-bold mx-2">@item.Quantity</span>
                            <button type="button" class="quantity-btn btn-increase">
                                <i class="fa-solid fa-plus"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="summary-container">
            <div class="summary-card">
                <div class="data-row p-2">
                    <span>Order Code</span>
                    <span class="text-secondary">@Model.OrderCode</span>
                </div>
            </div>

            <div class="summary-card">
                <div class="inner-card" id="summary-items-list">
                    @foreach (var item in Model.CartItems)
                    {
                        <div class="data-row" id="summary-item-@item.Id">
                            <span>
                                <span class="summary-qty normal">@item.Quantity</span> x @item.Name
                            </span>
                            <span class="summary-price">RM @((item.UnitPrice * item.Quantity).ToString("F2"))</span>
                        </div>
                    }
                </div>

                <div class="inner-card">
                    <div class="data-row">
                        <span>Discount</span>
                        <span class="normal">- RM @discount.ToString("F2")</span>
                    </div>
                </div>

                <div class="inner-card">
                    <div class="data-row">
                        <span>Total</span>
                        <span id="grand-total">RM @total.ToString("F2")</span>
                    </div>
                </div>
            </div>

            <button type="button" class="order-btn">
                Place Order
            </button>
        </div>
    </div>

    <div class="recommendation-container">
        <h4 class="section-title">You might also like</h4>

        <div class="item-wrapper">
            @foreach (var item in menuItems)
            {
                <a asp-page="/Table/MenuItem/Index" 
                    asp-route-tableId="@Model.TableId" 
                    asp-route-menuItemId="@item.Id" 
                    class="item-card-link text-decoration-none text-reset"
                    data-category="@item.Type.ToString().ToLower()">
                        
                    <div class="item-card">
                        <div class="thumbnail-container">
                            <img class="thumbnail-img" src="@item.ImageUrl" alt="@item.Name" />
                        </div>

                        <div class="info-container">
                            <h3 class="item-title">@item.Name</h3>

                            <div class="bottom-section">
                                <span class="price">@item.Price</span>
                                <span class="category">
                                    @if(@item.Type.ToString() == "Beverage")
                                    {
                                        <i class="fa-solid fa-martini-glass-citrus"></i>
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-utensils me-1"></i>
                                    }
                                    @item.Type.ToString()
                                </span>
                            </div>
                        </div>
                    </div>

                </a>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/cart.js" asp-append-version="true"></script>
}