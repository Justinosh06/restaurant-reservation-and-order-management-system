@page "/Table/{tableId}/Checkout"
@model RestaurantReservation.Pages.Table.CheckoutModel
@{
    ViewData["Title"] = $"Table {Model.TableId} Checkout";
}

<link rel="stylesheet" href="~/css/checkout_page.css" asp-append-version="true">

@if (User.Identity?.IsAuthenticated != true && !Model.IsCustomerBound)
{
    <div class="modal fade checkout-choice-modal" id="checkoutChoiceModal" tabindex="-1"
         aria-labelledby="checkoutChoiceModalLabel" aria-hidden="true"
         data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body">
                    <h2 class="modal-title" id="checkoutChoiceModalLabel">Ready to check out?</h2>
                    <p>Continue as a guest, or log in to your account before checkout.</p>
                    <div class="checkout-choice-actions">
                        <button type="button" class="checkout-choice-guest" data-bs-dismiss="modal">
                            Continue as guest
                        </button>
                        <a class="checkout-choice-login"
                           asp-page="/Login"
                           asp-route-returnUrl="@($"/Table/{Model.TableId}/Checkout")">
                            Log in
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div class="checkout-container">
    <h2 class="section-title">Your Orders</h2>
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <p class="alert-text" role="status">@Model.StatusMessage</p>
    }
    <div class="order-list">
        @foreach (var order in Model.SessionOrders)
        {
            <details class="order-wrapper">
                <summary class="order-btn">
                    <div class="d-flex title-row">
                        <div>
                            <h4 class="title">Order</h4>
                            <h4 class="title-id">#@order.OrderCode</h4>
                        </div>

                        <div class="status">@order.Status</div>
                    </div>
                    <span class="detail">@order.FormattedTime</span>
                </summary>

                <div class="order-items">
                    @foreach (var item in order.Items)
                    {
                        <div class="order-item">
                            <div class="d-flex justify-content-between">
                                <div class="order-item-details">
                                    <span class="order-item-name">@item.Name</span>
                                    @if (!string.IsNullOrWhiteSpace(item.Options))
                                    {
                                        <span class="order-item-remark">@item.Options</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.Remark))
                                    {
                                        <span class="order-item-remark">@item.Remark</span>
                                    }
                                </div>

                                <span class="order-item-price">@Model.CurrencySymbol @((item.UnitPrice * item.Quantity).ToString("F2"))</span>
                            </div>

                            <span class="order-item-quantity">Quantity: @item.Quantity</span>
                        </div>
                    }

                    @if (order.CanCancel)
                    {
                        <form method="post"
                              asp-page-handler="CancelOrder"
                              asp-route-tableId="@Model.TableId"
                              asp-route-orderId="@order.OrderId"
                              class="cancel-order-form">
                            <button type="submit" class="cancel-order-btn">Cancel order</button>
                        </form>
                    }
                </div>
            </details>
        }
        @if (Model.SessionOrders.Count == 0)
        {
            <div class="empty-container">
                <p class="empty-text">No orders have been placed for this dining session yet.</p>
                <a class="view-cart-btn" asp-page="/Table/Cart" asp-route-tableId="@Model.TableId">View cart</a>
            </div>
        }
    </div>

    @if (Model.SessionOrders.Count > 0)
    {
        @if (!Model.IsSessionClosed)
        {
            <div class="promo-code-box">
                @if (Model.AppliedPromotion is not null)
                {
                    <form method="post" asp-page-handler="RemovePromoCode" asp-route-tableId="@Model.TableId" class="promo-applied">
                        <i class="fa-solid fa-ticket" aria-hidden="true"></i>
                        <div class="promo-applied-text">
                            <strong>@Model.AppliedPromotion.Code</strong>
                            <span>@Model.AppliedPromotion.Title</span>
                        </div>
                        <button type="submit" class="promo-remove-btn">Remove</button>
                    </form>
                    @if (Model.PromoDiscount == 0 && Model.AppliedPromotion.MinimumSpend > 0)
                    {
                        <p class="promo-feedback">
                            Spend @Model.CurrencySymbol @((Model.AppliedPromotion.MinimumSpend / 100m - Model.TotalAmount).ToString("F2")) more
                            to get this discount (minimum spend @Model.CurrencySymbol @((Model.AppliedPromotion.MinimumSpend / 100m).ToString("F2"))).
                        </p>
                    }
                }
                else
                {
                    <form method="post" asp-page-handler="ApplyPromoCode" asp-route-tableId="@Model.TableId" class="promo-form">
                        <label for="promoCode" class="visually-hidden">Promo code</label>
                        <input type="text" id="promoCode" name="promoCode" class="promo-input" placeholder="Promo code"
                               maxlength="20" autocomplete="off" autocapitalize="characters" spellcheck="false"
                               aria-describedby="promoFeedback" />
                        <button type="submit" class="promo-apply-btn">Apply</button>
                    </form>
                }

                @if (!string.IsNullOrWhiteSpace(Model.PromoError ?? Model.PromoRemovedNotice))
                {
                    <p class="promo-feedback promo-feedback-error" id="promoFeedback" role="alert">@(Model.PromoError ?? Model.PromoRemovedNotice)</p>
                }
                else if (!string.IsNullOrWhiteSpace(Model.PromoMessage))
                {
                    <p class="promo-feedback" id="promoFeedback" role="status">@Model.PromoMessage</p>
                }

                @* Members-only and birthday codes need an account; the login choice is otherwise only in the pop-up. *@
                @if (User.Identity?.IsAuthenticated != true && !Model.IsCustomerBound)
                {
                    <p class="promo-feedback">
                        Have a member or birthday code?
                        <a asp-page="/Login" asp-route-returnUrl="@($"/Table/{Model.TableId}/Checkout")">Log in</a> to use it.
                    </p>
                }
            </div>
        }

        @if (Model.ReservationDepositCredit > 0 || Model.PromoDiscount > 0)
        {
            <div class="checkout-total-breakdown">
                <div><span>Orders total</span><span>@Model.CurrencySymbol @Model.TotalAmount.ToString("F2")</span></div>
                @if (Model.PromoDiscount > 0)
                {
                    <div><span>Promo code @Model.AppliedPromotion?.Code</span><span>- @Model.CurrencySymbol @Model.PromoDiscount.ToString("F2")</span></div>
                }
                @if (Model.ReservationDepositCredit > 0)
                {
                    <div><span>Reservation deposit</span><span>- @Model.CurrencySymbol @Model.ReservationDepositCredit.ToString("F2")</span></div>
                }
                <div class="checkout-amount-due"><strong>Amount due</strong><strong>@Model.CurrencySymbol @Model.AmountDue.ToString("F2")</strong></div>
            </div>
        }

        @if (!Model.IsSessionClosed)
        {
            <form method="post" asp-page-handler="PayWithStripe" asp-route-tableId="@Model.TableId">
                <button type="submit" class="pay-btn w-100" disabled="@(!Model.CanPay)">
                    <h4 class="total-price">@Model.CurrencySymbol @Model.AmountDue.ToString("F2")</h4>
                    @if (Model.AmountDue == 0)
                    {
                        <span>@(Model.ReservationDepositCredit > 0 ? "Complete checkout with deposit" : "Complete checkout")</span>
                    }
                    else
                    {
                        <span class="d-flex align-items-center gap-1">Pay with <span class="fa-brands fa-stripe icon"></span></span>
                    }
                </button>
            </form>
        }
    }
</div>

@if (User.Identity?.IsAuthenticated != true && !Model.IsCustomerBound)
{
    @section Scripts {
        <script>
            bootstrap.Modal.getOrCreateInstance(document.getElementById("checkoutChoiceModal")).show();
        </script>
    }
}