@page "/Table/{tableId}"
@using RestaurantReservation.Models.Enums
@model RestaurantReservation.Pages.Table.IndexModel
@{
    ViewData["Title"] = $"Table {Model.TableId}";
}

<link rel="stylesheet" href="~/css/table_page.css" asp-append-version="true" />

@* Today's promotions pop up once per browser tab. *@
<partial name="_PromotionPopup" />

@if (!Model.HasActiveSession)
{
    <main class="dining-session-start">
        <h1 class="title">Welcome to Table @Model.TableId</h1>
        <p>Start a dining session to browse the menu and place an order.</p>
        <form method="post" asp-page-handler="StartSession" asp-route-tableId="@Model.TableId">
            <button type="submit" class="start-session-button">Start dining session</button>
        </form>
    </main>
}
else
{
    <div class="menu-container">
        <div class="menu-header">
            <h1 class="title">Menu<span class="content-number" id="menu-total-count">@Model.MenuItems.Count</span></h1>

            <div class="pill-filter-row">
            <div class="menu-search">
                <button type="button" class="searchbar-btn" aria-label="Search menu" aria-expanded="false">
                    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                </button>

                <div class="search-modal" role="dialog" aria-modal="true" aria-labelledby="menu-search-title" hidden>
                    <form class="searchbar-popup">
                        <input id="menu-search-input" class="searchbar-input" type="search" placeholder="Search menu items" autocomplete="off" />
                        <button type="submit" class="searchbar-submit">Search</button>
                        <button type="button" class="searchbar-close" aria-label="Close search">&times;</button>
                    </form>
                    <div class="search-recommendations" hidden>
                        <div class="search-recommendation-group search-recent-searches" hidden>
                            <h2>Recent searches</h2>
                            <ul class="search-recommendation-list"></ul>
                        </div>
                        <div class="search-recommendation-group search-top-rated" hidden>
                            <h2>Top rated</h2>
                            <ul class="search-recommendation-list"></ul>
                        </div>
                        <div class="search-recommendation-group search-matches" hidden>
                            <h2>Suggestions</h2>
                            <ul class="search-recommendation-list"></ul>
                            <p class="search-recommendation-empty" hidden>No matching menu items.</p>
                        </div>
                    </div>
                </div>

                <div class="active-search" hidden>
                    <button type="button" class="active-search-query"></button>
                    <button type="button" class="clear-search" aria-label="Clear search">&times;</button>
                </div>
            </div>

            <button class="filter-pill active" data-category="all">
                All
            </button>

            @foreach (var type in Model.MenuItems.Select(item => item.MenuItemType).Distinct().OrderBy(type => type))
            {
                var count = Model.MenuItems.Count(item => item.MenuItemType == type);
                <button class="filter-pill" data-category="@type.ToString().ToLower()">
                    @type.ToString()
                </button>
            }
            </div>
        </div>

        <div class="menu-grid">
        @foreach (var item in Model.MenuItems)
        {
            <a asp-page="/Table/MenuItem/Index" 
               asp-route-tableId="@Model.TableId" 
               asp-route-menuItemId="@item.Id" 
               class="item-card-link text-decoration-none text-reset"
               data-category="@item.MenuItemType.ToString().ToLower()"
               data-search-name="@item.Name"
               data-top-rated-order="@Model.TopRatedMenuItemIds.IndexOf(item.Id)">
                
                <div class="item-card">
                    <div class="thumbnail-container">
                        @if (!string.IsNullOrWhiteSpace(item.ThumbnailImage))
                        {
                            <img class="thumbnail-img" src="@item.ThumbnailImage" alt="@item.Name" />
                        }
                        else
                        {
                            <i class="fa-solid fa-utensils icon"></i>
                        }
                    </div>

                    <div class="info-container">
                        <h3 class="item-title">@item.Name</h3>

                        <div class="bottom-section">
                            <span class="price">RM @item.PriceInMainUnit.ToString("F2")</span>
                            <span class="category">
                                @if(item.MenuItemType == MenuItemType.Beverage)
                                {
                                    <i class="fa-solid fa-martini-glass-citrus"></i>
                                }
                                else
                                {
                                    <i class="fa-solid fa-utensils me-1"></i>
                                }
                                @item.MenuItemType
                            </span>
                        </div>
                    </div>
                </div>

            </a>
        }
        </div>
    </div>
}

@section Scripts {
    @if (Model.HasActiveSession)
    {
        <script src="~/js/tableMenu.js" asp-append-version="true"></script>
    }
}