@page
@model LoginModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Login";
    ViewData["Headline"] = "Welcome back.";
    ViewData["Tagline"] = "Log in to book a table, see your dining history and review your favourite dishes.";
}

<h2 class="card-title">Log in</h2>
<p class="hint mb-3">For customers, staff and administrators.</p>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <p class="notice">@Model.SuccessMessage</p>
}

<form method="post" id="loginForm" class="auth-form">
    <div asp-validation-summary="ModelOnly" class="field-error" role="alert"></div>

    <div class="auth-field">
        <label asp-for="Input.Email"></label>
        <input asp-for="Input.Email" autocomplete="username" placeholder="name@example.com" />
        <span asp-validation-for="Input.Email" class="field-error"></span>
    </div>

    <div class="auth-field">
        <label asp-for="Input.Password"></label>
        <input asp-for="Input.Password" autocomplete="current-password" placeholder="Enter your password" />
        <span asp-validation-for="Input.Password" class="field-error"></span>
        <span class="hint">Forgot your password? Email <a href="mailto:admin@restaurant.com">admin@restaurant.com</a>.</span>
    </div>

    <button type="button" id="loginButton" class="pill-btn w-100">Log in</button>

    <!-- CAPTCHA step: opens after the Login button is clicked -->
    <div class="modal fade" id="captchaModal" tabindex="-1" aria-labelledby="captchaModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="captchaModalLabel">Security check</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">Type the characters shown in the image to confirm you are not a robot.</p>
                    <div class="d-flex align-items-center flex-wrap gap-2 mb-3">
                        <img id="captchaImage" alt="CAPTCHA image" width="200" height="70" class="border rounded" />
                        <button type="button" id="refreshCaptcha" class="pill-btn ghost small-btn">&#x21bb; New image</button>
                    </div>
                    <div class="auth-field">
                        <label asp-for="Input.CaptchaAnswer"></label>
                        <input asp-for="Input.CaptchaAnswer" class="text-uppercase" autocomplete="off" maxlength="5" />
                        <span id="captchaError" class="field-error d-none">Please enter the characters shown.</span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="pill-btn ghost" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="pill-btn">Verify &amp; log in</button>
                </div>
            </div>
        </div>
    </div>
</form>

<div class="auth-switch">
    <span class="hint">First time here?</span>
    <a asp-page="/Register" class="pill-btn ghost w-100">Create a customer account</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/login.js" asp-append-version="true"></script>
}
