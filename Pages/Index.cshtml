@page
@using RestaurantReservation.Extensions
@using RestaurantReservation.Infrastructure.Authentication
@using RestaurantReservation.Infrastructure.Reviews
@using Restaurant_Reservation_and_Order_Management_System.Pages.Customer
@model IndexModel
@{
    ViewData["Title"] = "Welcome";
    var isCustomer = User.IsInRole(AppRoles.Customer);

    // Everyone can browse the menu. Booking a table needs a customer account, so visitors log in first
    // and the login page then sends them on to the booking page.
    var menuUrl = Url.Page("/Menu/Index");
    // The customer booking page (Pages/Customer/Reserve) comes from the reservation module.
    const string reserveUrl = "/Customer/Reserve";

    const string mapEmbedUrl = "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3689.51102615882!2d113.98775958961416!3d22.372084687791705!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3403fb70f463265b%3A0xb412a51f5ac2f272!2sResto%20Bar%20%26%20Grill!5e0!3m2!1sen!2smy!4v1791788991346!5m2!1sen!2smy";
    // Same place as the embedded map, opened in Google Maps.
    const string mapOpenUrl = "https://www.google.com/maps?cid=12975615030493114994";

    // Opening hours use the server's local time. A closing time earlier than the opening time runs past midnight.
    var now = DateTime.Now;
    var today = now.DayOfWeek;
    bool IsOpenDay(RestaurantReservation.Models.BusinessHours h) => !h.IsClosed && h.OpenTime is not null && h.CloseTime is not null;
    bool OpenAt(RestaurantReservation.Models.BusinessHours h, TimeOnly time) =>
        IsOpenDay(h) && (h.OpenTime < h.CloseTime
            ? time >= h.OpenTime && time < h.CloseTime
            : time >= h.OpenTime || time < h.CloseTime);
    var todaysHours = Model.OpeningHours.FirstOrDefault(h => h.DayOfWeek == today);
    var openNow = todaysHours is not null && OpenAt(todaysHours, TimeOnly.FromDateTime(now));
}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&display=swap" />
<link rel="stylesheet" href="~/css/landing_page.css" asp-append-version="true" />

<div class="landing home">
    <partial name="_LandingNav" model="Model.RestaurantName" />

    <section class="hero">
        <div class="hero-text">
            <h1 class="hero-title">Fresh pasta, good coffee, a table for you.</h1>
            @* <span class="hero-tag">Dine in &middot; Reserve ahead</span> *@
        </div>
        <img class="hero-img" src="~/images/landing-hero.jpg" alt="Dishes served at @Model.RestaurantName" />
    </section>

    <section class="booking-row">
        @* Book a table: the same date range, closed days, times and party size as the booking page
           (Pages/Customer/Reserve), which opens with these choices filled in. Visitors log in first. *@
        <form class="reservation-card" method="get" action="@reserveUrl" id="bookingCard"
              data-first-day="@Model.FirstBookingDay.ToString("yyyy-MM-dd")"
              data-last-day="@Model.LastBookingDay.ToString("yyyy-MM-dd")"
              data-closed-days="@string.Join(' ', Model.ClosedDays)">
            <div class="booking-head">
                <h2 class="card-title">Book a table</h2>
                <p class="hint mb-0">Book at least @ReserveModel.MinDaysAhead days ahead. Your table is held for 2 hours.</p>
            </div>

            <div class="booking-field">
                <span class="booking-label" id="bookingDateLabel"><i class="fa-regular fa-calendar" aria-hidden="true"></i> Date</span>
                <div class="dropdown">
                    <input type="hidden" name="date" id="bookingDate" />
                    <button type="button" class="booking-select" id="bookingDateButton" data-bs-toggle="dropdown"
                            data-bs-auto-close="outside" aria-expanded="false" aria-labelledby="bookingDateLabel bookingDateText">
                        <span id="bookingDateText">Choose a date</span>
                        <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                    </button>
                    <div class="dropdown-menu booking-calendar" id="bookingCalendar"></div>
                </div>
            </div>

            <div class="booking-field">
                <label class="booking-label" for="bookingTime"><i class="fa-regular fa-clock" aria-hidden="true"></i> Time</label>
                <div class="booking-select-wrap">
                    <select name="time" id="bookingTime" class="booking-select" disabled>
                        <option value="">Choose a date first</option>
                    </select>
                    <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                </div>
            </div>

            <div class="booking-field">
                <span class="booking-label" id="bookingGuestsLabel"><i class="fa-solid fa-user-group" aria-hidden="true"></i> Guests</span>
                <div class="guest-stepper" role="group" aria-labelledby="bookingGuestsLabel">
                    <button type="button" id="bookingGuestsDown" aria-label="Fewer guests"><i class="fa-solid fa-minus" aria-hidden="true"></i></button>
                    <input type="number" name="guests" id="bookingGuests" value="2" min="1" max="@ReserveModel.MaxPartySize"
                           inputmode="numeric" aria-label="Number of guests" />
                    <button type="button" id="bookingGuestsUp" aria-label="More guests"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
                </div>
            </div>

            <button type="submit" class="pill-btn w-100">Reserve a table</button>
            @if (!isCustomer)
            {
                <p class="hint text-center mb-0">You'll log in first, then finish booking.</p>
            }
        </form>

        <div class="today-menu">
            <div class="list-head">
                <h2 class="section-title">Top Rating</h2>
                <p class="hint mb-0">Our guests' favourite dishes, by their reviews.</p>
            </div>

            @if (Model.TopRated.Count == 0)
            {
                <p class="empty-note">Our menu is being updated. Please check back soon.</p>
            }
            else
            {
                <ol class="rank-list">
                    @for (var i = 0; i < Model.TopRated.Count; i++)
                    {
                        var item = Model.TopRated[i];
                        var rated = Model.Ratings.TryGetValue(item.Id, out var rating);

                        <li>
                            <a class="rank-row" asp-page="/Menu/Item" asp-route-menuItemId="@item.Id" asp-route-from="home">
                                <span class="rank-number">@(i + 1)</span>
                                <span class="rank-info">
                                    <span class="rank-name">@item.Name</span>
                                    <span class="rank-meta">
                                        @item.MenuItemType
                                        &middot;
                                        @if (rated)
                                        {
                                            <span class="rank-stars" aria-label="Rated @rating.Average.ToString("0.0") out of 5">
                                                <i class="fa-solid fa-star" aria-hidden="true"></i> @rating.Average.ToString("0.0")
                                            </span>
                                            <span>(@rating.Count @(rating.Count == 1 ? "review" : "reviews"))</span>
                                        }
                                        else
                                        {
                                            <span>No reviews yet</span>
                                        }
                                    </span>
                                </span>
                                <span class="menu-price">@Model.Currency.FormatCents(item.Price)</span>
                            </a>
                        </li>
                    }
                </ol>
            }

            <a href="@menuUrl" class="pill-btn menu-btn">
                View full menu <i class="fa-solid fa-arrow-right ms-1"></i>
            </a>
        </div>
    </section>

    @if (Model.NewArrivals.Count > 0)
    {
        <section class="specials">
            <h2 class="section-title text-center">New Arrival</h2>

            @* The four newest dishes, newest on the left, in the same card as the menu page (Pages/Menu/Index):
               picture, name and category, price. from=home makes the dish page's back button return here. *@
            <div class="specials-grid">
                @foreach (var item in Model.NewArrivals)
                {
                    var isBeverage = item.MenuItemType == RestaurantReservation.Models.Enums.MenuItemType.Beverage;

                    <a class="special-link" asp-page="/Menu/Item" asp-route-menuItemId="@item.Id" asp-route-from="home">
                        <div class="special-card">
                            <div class="special-thumb">
                                @if (!string.IsNullOrWhiteSpace(item.ThumbnailImage))
                                {
                                    <img src="@Url.Content(item.ThumbnailImage)" alt="@item.Name" />
                                }
                                else
                                {
                                    <i class="fa-solid @(isBeverage ? "fa-martini-glass-citrus" : "fa-utensils") special-placeholder" aria-hidden="true"></i>
                                }
                            </div>

                            <div class="special-info">
                                <div class="special-name">
                                    <h3>@item.Name</h3>
                                    <span>
                                        <i class="fa-solid @(isBeverage ? "fa-martini-glass-citrus" : "fa-utensils")" aria-hidden="true"></i>
                                        @item.MenuItemType
                                    </span>
                                </div>
                                <span class="special-price">@Model.Currency.FormatCents(item.Price)</span>
                            </div>
                        </div>
                    </a>
                }
            </div>
        </section>
    }

    @* Reviews: the overall score and who rated us, then up to three reviews (name card + quote card each,
       the middle one upside down like a staggered wall). Every review is on the Reviews page. *@
    <section class="reviews-section" aria-labelledby="reviewsTitle">
        <h2 class="section-title text-center" id="reviewsTitle">Reviews</h2>

        <div class="review-wall">
            <div class="rw-summary">
                <div class="rw-score">
                    <span class="rw-score-value">@Model.ReviewAverage.ToString("0.0")<small>/5</small></span>
                    <p class="rw-score-text">
                        @if (Model.ReviewCount == 0)
                        {
                            <text>No reviews yet. Dine with us and be the first to share your thoughts.</text>
                        }
                        else
                        {
                            <text>From <strong>@Model.ReviewCount @(Model.ReviewCount == 1 ? "review" : "reviews")</strong> by guests who dined with us.</text>
                        }
                    </p>
                </div>

                <div class="rw-trust">
                    <span class="rw-brand">@Model.RestaurantName</span>
                    <div class="rw-trust-row">
                        <div class="rw-avatars" aria-hidden="true">
                            @foreach (var initial in Model.RecentReviewerInitials)
                            {
                                <span class="rw-avatar">@initial</span>
                            }
                            @if (Model.ReviewerCount > Model.RecentReviewerInitials.Count)
                            {
                                <span class="rw-avatar more">@(Model.ReviewerCount - Model.RecentReviewerInitials.Count)+</span>
                            }
                        </div>
                        <div class="rw-trust-text">
                            <span class="rw-stars" aria-label="@Model.ReviewAverage.ToString("0.0") out of 5">
                                @for (var star = 1; star <= 5; star++)
                                {
                                    <i class="@(Model.ReviewAverage >= star ? "fa-solid fa-star" : Model.ReviewAverage >= star - 0.5 ? "fa-solid fa-star-half-stroke" : "fa-regular fa-star")" aria-hidden="true"></i>
                                }
                            </span>
                            <span>Rated by <strong>@Model.ReviewerCount @(Model.ReviewerCount == 1 ? "guest" : "guests")</strong> &middot; @Model.FiveStarPercent% gave 5 stars</span>
                        </div>
                    </div>
                    <a asp-page="/Reviews" class="pill-btn w-100">See all reviews</a>
                </div>
            </div>

            @for (var i = 0; i < Model.FeaturedReviews.Count; i++)
            {
                var review = Model.FeaturedReviews[i];

                <div class="rw-column @(i == 1 ? "flipped" : "")">
                    <div class="rw-person">
                        <span class="rw-avatar" aria-hidden="true">@ReviewDisplay.Initial(review.Customer)</span>
                        <strong>@ReviewDisplay.Name(review.Customer)</strong>
                    </div>
                    <div class="rw-quote">
                        <div class="rw-quote-top">
                            <span class="rw-stars" aria-label="@review.Rating out of 5">
                                @for (var star = 1; star <= 5; star++)
                                {
                                    <i class="@(star <= review.Rating ? "fa-solid" : "fa-regular") fa-star" aria-hidden="true"></i>
                                }
                            </span>
                            @if (review.MenuItem is not null)
                            {
                                <a asp-page="/Menu/Item" asp-route-menuItemId="@review.MenuItemId" asp-route-from="home"
                                   class="rw-dish-link">
                                    <span>@review.MenuItem.Name</span>
                                    <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                                </a>
                            }
                            <partial name="_ItemOptions" model="Model.OptionsFor(review)" />
                        </div>
                        <p class="rw-quote-text">@review.Description</p>
                    </div>
                </div>
            }
        </div>
    </section>

    <section class="location">
        <iframe class="map" title="Map to @Model.RestaurantName" src="@mapEmbedUrl"
                allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>

        <div class="location-info">
            <h2 class="section-title">Location &amp; opening hours</h2>

            @if (Model.Settings is null)
            {
                <p class="empty-note">Our address and opening hours will be announced soon.</p>
            }
            else
            {
                @* One block per detail: icon, small label, then the value. *@
                <div class="info-block">
                    <i class="fa-solid fa-location-dot info-icon" aria-hidden="true"></i>
                    <div>
                        <h3 class="info-label">Address</h3>
                        <p class="info-value address">@Model.Settings.Address</p>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Settings.PhoneNumber))
                {
                    <div class="info-block">
                        <i class="fa-solid fa-phone info-icon" aria-hidden="true"></i>
                        <div>
                            <h3 class="info-label">Phone</h3>
                            <a class="info-value" href="tel:@Model.Settings.PhoneNumber.Replace(" ", "")">@Model.Settings.PhoneNumber</a>
                        </div>
                    </div>
                }

                @if (Model.OpeningHours.Count > 0)
                {
                    <div class="info-block">
                        <i class="fa-regular fa-clock info-icon" aria-hidden="true"></i>
                        <div class="info-hours">
                            <div class="hours-head">
                                <h3 class="info-label">Opening hours</h3>
                                <span class="open-status @(openNow ? "open" : "closed")">@(openNow ? "Open now" : "Closed now")</span>
                            </div>

                            <ul class="hours-list">
                                @foreach (var hours in Model.OpeningHours)
                                {
                                    <li class="@(hours.DayOfWeek == today ? "today" : "")">
                                        <span class="day">
                                            @hours.DayOfWeek
                                            @if (hours.DayOfWeek == today)
                                            {
                                                <span class="today-tag">Today</span>
                                            }
                                        </span>
                                        @if (IsOpenDay(hours))
                                        {
                                            <span class="time">@hours.OpenTime!.Value.ToString("h:mm tt") &ndash; @hours.CloseTime!.Value.ToString("h:mm tt")</span>
                                        }
                                        else
                                        {
                                            <span class="time closed">Closed</span>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                }
            }
        </div>

        <a href="@mapOpenUrl" target="_blank" rel="noopener" class="pill-btn location-btn">
            Open map <i class="fa-solid fa-arrow-up-right-from-square ms-2"></i>
        </a>
    </section>

    <footer class="landing-footer">
        <span>&copy; @DateTime.Today.Year @Model.RestaurantName</span>
        <partial name="_PolicyLinks" />
    </footer>
</div>

@* Today's promotions pop up once per browser tab. *@
<partial name="_PromotionPopup" />

@section Scripts {
    <script src="~/js/landingBooking.js" asp-append-version="true"></script>
    <script>
        // A page brought back by the Back button is a snapshot from before login or logout, so load it again.
        window.addEventListener('pageshow', function (e) {
            if (e.persisted) {
                location.reload();
            }
        });
    </script>
}

<script src='https://www.noupe.com/embed/01a153e8a9187000835c6067bcc7f817f408.js'></script>
